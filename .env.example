# Supabase (client-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-side only)
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for Python training scripts.
# Use the Supabase Postgres connection string from the dashboard.
DATABASE_URL=

# Supabase Storage (for model artifacts)
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET_MODELS=model-artifacts

# App URL (optional; useful for debugging and logs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

